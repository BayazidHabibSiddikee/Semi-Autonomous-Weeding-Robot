<?xml version="1.0"?>
<robot name="weed_laser_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- =========================================================================
       Semi-Autonomous Weeding Robot — Reconciled ROS 2 Jazzy URDF/Xacro
       Drivetrain Decision: 4 physical wheels wired as 2 paired differential
       channels (Left Pair: FL+RL on Channel A, Right Pair: FR+RR on Channel B)
       with quadrature encoders on rear driven axles (64 CPR x 270:1 gearbox).
       Matches L298N / dual-channel H-bridge hardware & ros2_control diff_drive.
       ========================================================================= -->

  <xacro:arg name="use_sim" default="true"/>

  <!-- Kinematics matching physical CAD (weed_robot_chassis.FCStd) -->
  <xacro:property name="wheel_radius" value="0.035"/>
  <xacro:property name="wheel_width" value="0.026"/>
  <xacro:property name="wheel_separation" value="0.174"/>
  <xacro:property name="wheelbase_x" value="0.1275"/>
  <xacro:property name="track_half_y" value="0.087"/>

  <material name="wood_brown"><color rgba="0.72 0.50 0.30 1.0"/></material>
  <material name="yellow_plastic"><color rgba="0.95 0.82 0.08 1.0"/></material>
  <material name="sensor_dark"><color rgba="0.14 0.17 0.22 1.0"/></material>
  <material name="accent_cyan"><color rgba="0.05 0.65 0.80 1.0"/></material>

  <!-- Ground projection frame (Z = 0) required by Nav2 & robot_localization -->
  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
  </joint>

  <!-- Chassis Frame -->
  <link name="base_link">
    <inertial>
      <!-- Updated mass including RPi5, ESP32, LiDAR, IMU, RTK-GNSS, dual cameras, 12V LiPo (~2.85 kg) -->
      <mass value="2.850"/>
      <origin xyz="0.0 0.0 0.095" rpy="0 0 0"/>
      <inertia ixx="0.0112" ixy="0.0" ixz="0.0"
               iyy="0.0198" iyz="0.0"
               izz="0.0245"/>
    </inertial>
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://rover_description/meshes/chassis_base.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="wood_brown"/>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.12675" rpy="0 0 0"/>
      <geometry><box size="0.256 0.155 0.0035"/></geometry>
    </collision>
    <collision>
      <origin xyz="0.0 0.0565 0.080" rpy="0 0 0"/>
      <geometry><box size="0.255 0.022 0.090"/></geometry>
    </collision>
    <collision>
      <origin xyz="0.0 -0.0565 0.080" rpy="0 0 0"/>
      <geometry><box size="0.255 0.022 0.090"/></geometry>
    </collision>
  </link>

  <!-- Wheel Macro (4 wheels; FL+RL and FR+RR mechanically/electrically paired) -->
  <xacro:macro name="rover_wheel" params="prefix x_pos y_pos z_pos flip_y">
    <link name="${prefix}_wheel_link">
      <inertial>
        <mass value="0.065"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.000023" ixy="0.0" ixz="0.0"
                 iyy="0.000039" iyz="0.0"
                 izz="0.000023"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 ${3.14159 if flip_y else 0}"/>
        <geometry>
          <mesh filename="package://rover_description/meshes/wheel.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="yellow_plastic"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.570796 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="${x_pos} ${y_pos} ${z_pos}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="3.8" velocity="15.0"/>
      <dynamics damping="0.02" friction="0.08"/>
    </joint>
  </xacro:macro>

  <xacro:rover_wheel prefix="front_left"  x_pos="${wheelbase_x}"  y_pos="${track_half_y}"  z_pos="${wheel_radius}" flip_y="false"/>
  <xacro:rover_wheel prefix="rear_left"   x_pos="-${wheelbase_x}" y_pos="${track_half_y}"  z_pos="${wheel_radius}" flip_y="false"/>
  <xacro:rover_wheel prefix="front_right" x_pos="${wheelbase_x}"  y_pos="-${track_half_y}" z_pos="${wheel_radius}" flip_y="true"/>
  <xacro:rover_wheel prefix="rear_right"  x_pos="-${wheelbase_x}" y_pos="-${track_half_y}" z_pos="${wheel_radius}" flip_y="true"/>

  <!-- =========================================================================
       Navigation Sensor Suite
       ========================================================================= -->

  <!-- 1. 9-DOF IMU (Adafruit BNO055) at chassis center -->
  <link name="imu_link">
    <visual>
      <geometry><box size="0.027 0.020 0.005"/></geometry>
      <material name="accent_cyan"/>
    </visual>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0.0 0.0 0.132" rpy="0 0 0"/>
  </joint>

  <!-- 2. 2D LiDAR (RPLiDAR A1M8) elevated above deck for clear 360-deg scan -->
  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.038" length="0.041"/></geometry>
      <material name="sensor_dark"/>
    </visual>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.030 0.0 0.175" rpy="0 0 0"/>
  </joint>

  <!-- 3. Forward-Facing Crop-Row Navigation Camera (Global Shutter AR0234, tilted 25 deg down) -->
  <link name="nav_camera_link">
    <visual>
      <geometry><box size="0.032 0.038 0.032"/></geometry>
      <material name="sensor_dark"/>
    </visual>
  </link>
  <joint name="nav_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="nav_camera_link"/>
    <origin xyz="0.132 0.0 0.150" rpy="0 0.4363 0"/>
  </joint>

  <link name="nav_camera_optical_frame"/>
  <joint name="nav_camera_optical_joint" type="fixed">
    <parent link="nav_camera_link"/>
    <child link="nav_camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.570796 0 -1.570796"/>
  </joint>

  <!-- 4. Downward-Facing Weed Detection Camera (preserved for Weed_Detection pipeline) -->
  <link name="weed_camera_link">
    <visual>
      <geometry><box size="0.030 0.030 0.025"/></geometry>
      <material name="sensor_dark"/>
    </visual>
  </link>
  <joint name="weed_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="weed_camera_link"/>
    <origin xyz="0.0 0.0 0.120" rpy="0 1.570796 0"/>
  </joint>

  <!-- 5. RTK-GNSS Antenna (Holybro H-RTK ZED-F9P) on top mast -->
  <link name="gps_link">
    <visual>
      <geometry><cylinder radius="0.030" length="0.018"/></geometry>
      <material name="accent_cyan"/>
    </visual>
  </link>
  <joint name="gps_joint" type="fixed">
    <parent link="base_link"/>
    <child link="gps_link"/>
    <origin xyz="-0.060 0.0 0.240" rpy="0 0 0"/>
  </joint>

  <!-- =========================================================================
       ros2_control Hardware Interface (Paired Left/Right Channels)
       ========================================================================= -->
  <ros2_control name="WeedRoverSystem" type="system">
    <hardware>
      <xacro:if value="$(arg use_sim)">
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </xacro:if>
      <xacro:unless value="$(arg use_sim)">
        <plugin>rover_hardware/Esp32DiffDriveHardware</plugin>
        <param name="serial_port">/dev/ttyUSB0</param>
        <param name="baud_rate">115200</param>
        <param name="enc_ticks_per_rev">17280</param>
        <param name="watchdog_timeout_ms">250</param>
      </xacro:unless>
    </hardware>

    <!-- All 4 joints exposed; diff_drive_controller couples FL+RL and FR+RR -->
    <joint name="front_left_wheel_joint">
      <command_interface name="velocity"><param name="min">-12.0</param><param name="max">12.0</param></command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="rear_left_wheel_joint">
      <command_interface name="velocity"><param name="min">-12.0</param><param name="max">12.0</param></command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="front_right_wheel_joint">
      <command_interface name="velocity"><param name="min">-12.0</param><param name="max">12.0</param></command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="rear_right_wheel_joint">
      <command_interface name="velocity"><param name="min">-12.0</param><param name="max">12.0</param></command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- Gazebo Harmonic Sensor & Control Plugins -->
  <gazebo>
    <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find rover_hardware)/config/ros2_control.yaml</parameters>
    </plugin>
  </gazebo>

  <gazebo reference="imu_link">
    <sensor name="bno055_imu" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <topic>/imu/data</topic>
    </sensor>
  </gazebo>

  <gazebo reference="lidar_link">
    <sensor name="rplidar_a1" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <topic>/scan</topic>
      <ray>
        <scan><horizontal><samples>360</samples><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan>
        <range><min>0.15</min><max>12.0</max></range>
      </ray>
    </sensor>
  </gazebo>

  <gazebo reference="nav_camera_link">
    <sensor name="nav_camera" type="camera">
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <topic>/nav_camera/image_raw</topic>
      <camera>
        <horizontal_fov>1.57</horizontal_fov>
        <image><width>640</width><height>480</height><format>R8G8B8</format></image>
      </camera>
    </sensor>
  </gazebo>
</robot>
