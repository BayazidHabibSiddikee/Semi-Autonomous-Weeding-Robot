<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_bringup</name>
  <version>0.1.0</version>
  <description>Launch files for physical and simulated weeding rover bringup.</description>
  <maintainer email="rover@example.com">Weeding Rover Team</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>rover_hardware</exec_depend>
  <exec_depend>rover_localization</exec_depend>
  <exec_depend>rover_navigation</exec_depend>
  <exec_depend>crop_row_navigation</exec_depend>
  <exec_depend>robot_safety</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_collision_monitor</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
