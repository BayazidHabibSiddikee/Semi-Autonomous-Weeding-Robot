# Optional Raspberry Pi 5 Navigation API base URL (server-side proxy only).
# Example for local LAN rover: PI_ROBOT_URL=http://192.168.4.1:8000
# Leave unset to run the dashboard in honest Simulation-Only mode.
PI_ROBOT_URL=

# Shared Bearer token required by Raspberry Pi FastAPI control endpoints (server-side proxy only).
PI_API_TOKEN=

